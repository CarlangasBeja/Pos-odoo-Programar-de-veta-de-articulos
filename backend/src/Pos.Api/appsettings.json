{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Odoo": {
    "BaseUrl": "http://localhost:8069",
    "Database": "pos",
    "PosConfigId": 0,
    "Language": "es_419",
    "TimeZone": "America/Bogota",
    "RequestTimeoutSeconds": 15,
    "SubmitTimeoutSeconds": 45,
    "ReferenceDataCacheSeconds": 300
  },

  "Auth": {
    "TokenLifetimeHours": 8
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Idempotency": {
    "FilePath": "App_Data/sale-attempts.json",
    "RetentionDays": 30
  },

  "Discounts": {
    "Manual": {
      "Enabled": true,
      "MaxPercentByRole": { "Cashier": 10, "Supervisor": 30 }
    },
    "Volume": {
      "Enabled": true,
      "MinQuantity": 10,
      "Percentage": 5,
      "AllowedRoles": [ "Cashier", "Supervisor" ]
    },
    "MinimumAmount": {
      "Enabled": true,
      "MinimumAmount": 100000,
      "Percentage": 3,
      "AllowedRoles": [ "Cashier", "Supervisor" ]
    }
  },

  "Operators": {
    "Accounts": []
  }
}
